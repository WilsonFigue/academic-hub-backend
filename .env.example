# Entorno: development | test | production
NODE_ENV=development
# Puerto y host donde escucha la API (no la base de datos).
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info

# ── PostgreSQL 18 ────────────────────────────────────────────────────────
# Opción A: datos separados (se usan cuando DATABASE_URL está vacía).
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# Opción B: URL completa; si se completa, tiene prioridad sobre los datos separados.
DATABASE_URL=

# Base separada para pruebas automatizadas (nunca la de desarrollo).
# Usa el mismo host/usuario/contraseña de arriba con otro nombre de base.
TEST_DB_NAME=
TEST_DATABASE_URL=

DB_POOL_MAX=10
# disable (solo local) | require (cifrado sin verificar certificado; prohibido en producción) | verify-full (cifrado verificado)
DB_SSL_MODE=verify-full
# Ruta opcional al certificado CA del servidor (p. ej. server-ca.pem de Cloud SQL).
DB_SSL_CA_FILE=
# Esquema propio: evita colisiones con tablas de otros proyectos en la misma base.
DB_SCHEMA=academic_hub

FRONTEND_ORIGIN=http://localhost:5173

SESSION_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

BLACKBOARD_READ_ONLY=true

# Solo desarrollo: habilita /internal/dev (≥32 caracteres). Nunca en producción.
DEV_OPERATOR_TOKEN=
