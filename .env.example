# Entorno: development | test | production
NODE_ENV=development
# Puerto y host donde escucha la API (no la base de datos).
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info

# ── PostgreSQL 18 ────────────────────────────────────────────────────────
# Opción A: datos separados (se usan cuando DATABASE_URL está vacía).
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# Opción B: URL completa; si se completa, tiene prioridad sobre los datos separados.
DATABASE_URL=

# Base separada para pruebas automatizadas (nunca la de desarrollo).
# Usa el mismo host/usuario/contraseña de arriba con otro nombre de base.
TEST_DB_NAME=
TEST_DATABASE_URL=

DB_POOL_MAX=10
# disable (solo local) | require (cifrado sin verificar certificado; prohibido en producción) | verify-full (cifrado verificado)
DB_SSL_MODE=verify-full
# Ruta opcional al certificado CA del servidor (p. ej. server-ca.pem de Cloud SQL).
DB_SSL_CA_FILE=
# Esquema propio: evita colisiones con tablas de otros proyectos en la misma base.
DB_SCHEMA=academic_hub

FRONTEND_ORIGIN=http://localhost:5173

SESSION_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

BLACKBOARD_READ_ONLY=true

# Solo desarrollo: habilita /internal/dev (≥32 caracteres). Nunca en producción.
DEV_OPERATOR_TOKEN=

# Guías de estudio con IA (OpenAI). Sin OPENAI_API_KEY las solicitudes quedan en cola.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
# Precios en USD por millón de tokens (confírmalos en la página oficial de OpenAI).
OPENAI_PRICE_IN_PER_M=1
OPENAI_PRICE_OUT_PER_M=5
STUDY_GUIDE_MONTHLY_CAP_USD=5
STUDY_GUIDE_MAX_PER_RUN=5
STUDY_GUIDE_MAX_INPUT_CHARS=120000

# Tareas resueltas con IA (agente con herramientas). Sin HOMEWORK_MODEL se usa el modelo y los precios de las guías.
HOMEWORK_MODEL=
HOMEWORK_PRICE_IN_PER_M=
HOMEWORK_PRICE_OUT_PER_M=
HOMEWORK_MONTHLY_CAP_USD=10
HOMEWORK_MAX_PER_TASK_USD=1.5
HOMEWORK_MAX_PER_RUN=5
HOMEWORK_MAX_TURNS=8
# Razonamiento del agente: none | low | medium | high.
HOMEWORK_REASONING_EFFORT=medium
HOMEWORK_ESTIMATED_COST_USD=0.8
