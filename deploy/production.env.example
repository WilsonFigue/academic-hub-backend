# Academic Hub · variables de PRODUCCIÓN. Copia este archivo como .env.production (en la raíz del backend, junto a docker-compose.yml)
# y rellena los valores. NUNCA lo subas a GitHub. Usa llaves NUEVAS para producción (no reutilices las de desarrollo).

LOG_LEVEL=info

# ── Base de datos (PostgreSQL 18, Google Cloud SQL) ─────────────────────────────────────────────────
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SCHEMA=academic_hub
# En producción es obligatorio verify-full: hace falta el certificado de la CA del servidor (consola de Cloud SQL → Conexiones → Seguridad).
# Guárdalo en ./certs/server-ca.pem (se monta como /app/certs/server-ca.pem).
DB_SSL_MODE=verify-full
DB_SSL_CA_FILE=/app/certs/server-ca.pem
# Si la verificación falla por el NOMBRE (al conectar por IP), indica aquí el nombre del certificado del servidor.
# DB_SSL_SERVERNAME=

# ── Web ────────────────────────────────────────────────────────────────────────────────────────────
# Origen EXACTO de la web en Vercel (sin ruta ni barra final), p. ej. https://academic-hub.vercel.app
FRONTEND_ORIGIN=
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
SESSION_TTL_DAYS=30

# ── Seguridad ─────────────────────────────────────────────────────────────────────────────────────
BLACKBOARD_READ_ONLY=true
# Clave para cifrar las credenciales recordadas de UTEC. Si usas la MISMA base de datos de desarrollo, debe ser la MISMA clave que allí.
CREDENTIALS_KEY=
# Clave de las rutinas por endpoint /jobs/* (mínimo 32 caracteres). Genera una: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# ── Inicio de sesión en UTEC ──────────────────────────────────────────────────────────────────────
# browser (por defecto: Chromium sin ventana) | auto (primero por HTTP y, si falla, Chromium) | http (solo HTTP)
BLACKBOARD_LOGIN_MODE=browser

# ── IA ────────────────────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
HOMEWORK_MODEL=gpt-6.1-sol
HOMEWORK_PRICE_IN_PER_M=2
HOMEWORK_PRICE_OUT_PER_M=10
HOMEWORK_MONTHLY_CAP_USD=10
HOMEWORK_MAX_PER_TASK_USD=1.5
HOMEWORK_REASONING_EFFORT=medium
HOMEWORK_ESTIMATED_COST_USD=0.8
HOMEWORK_MAX_TURNS=8
GUIDE_MODEL=gpt-6.1-sol
GUIDE_PRICE_IN_PER_M=2
GUIDE_PRICE_OUT_PER_M=10
GUIDE_REASONING_EFFORT=low

# ── Correo (Mailchimp) y Telegram ───────────────────────────────────────────────────────────────────
MAILCHIMP_API_KEY=
TELEGRAM_BOT_TOKEN=
# Con true (por defecto) el servidor atiende a Telegram y recalcula los recordatorios por su cuenta. NO uses a la vez un webhook de Telegram.
BACKGROUND_JOBS=true
