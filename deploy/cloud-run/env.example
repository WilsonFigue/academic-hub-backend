# Academic Hub · variables para Google Cloud Run.
# Copia este archivo como .env.cloudrun en la raíz del backend (junto a package.json) y rellena los valores.
# Ese archivo NO se sube a GitHub ni a Google Cloud Build; deploy/cloud-run/deploy.ps1 lo lee en tu computadora.
#
# NO pongas aquí (el script las define solo): NODE_ENV, HOST, PORT, DB_HOST, DB_SSL_*, DATABASE_URL, BACKGROUND_JOBS, COOKIE_SECURE.

LOG_LEVEL=info

# ── Base de datos (Cloud SQL). La conexión va por el conector de Cloud Run, sin IP ni certificado ───────────
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_PORT=5432
DB_SCHEMA=academic_hub

# ── Web ────────────────────────────────────────────────────────────────────────────────────────────────────
# Origen EXACTO de la web (sin ruta ni barra final), p. ej. https://academic-hub.vercel.app
FRONTEND_ORIGIN=
COOKIE_SAME_SITE=lax
SESSION_TTL_DAYS=30

# ── Seguridad ──────────────────────────────────────────────────────────────────────────────────────────────
BLACKBOARD_READ_ONLY=true
# Clave que cifra las credenciales recordadas de UTEC. Con la MISMA base de datos que en tu computadora debe ser la MISMA clave de tu .env.
CREDENTIALS_KEY=
# Clave de las rutinas /jobs/* (mínimo 32 caracteres, solo letras y números). Genera una nueva:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# ── Inicio de sesión en UTEC ───────────────────────────────────────────────────────────────────────────────
# browser (Chromium sin ventana) | auto (primero por HTTP y, si falla, Chromium) | http (solo HTTP)
BLACKBOARD_LOGIN_MODE=browser

# ── IA ─────────────────────────────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
HOMEWORK_MODEL=gpt-6.1-sol
HOMEWORK_PRICE_IN_PER_M=2
HOMEWORK_PRICE_OUT_PER_M=10
HOMEWORK_MONTHLY_CAP_USD=10
HOMEWORK_MAX_PER_TASK_USD=1.5
HOMEWORK_REASONING_EFFORT=high
HOMEWORK_ESTIMATED_COST_USD=1.0
HOMEWORK_MAX_TURNS=8
GUIDE_MODEL=gpt-6.1-sol
GUIDE_PRICE_IN_PER_M=2
GUIDE_PRICE_OUT_PER_M=10
GUIDE_REASONING_EFFORT=low

# ── Correo (Mailchimp) y Telegram ──────────────────────────────────────────────────────────────────────────
MAILCHIMP_API_KEY=
TELEGRAM_BOT_TOKEN=

# ── Horarios de las rutinas (hora de El Salvador). Cloud Scheduler llama a /jobs/tick cada 5 minutos y el servidor
#    decide con estos horarios qué toca; cada horario corre una sola vez. «off» apaga una rutina. ─────────────
# Actualizar desde Blackboard + calendario + guías + tareas + avisos y Telegram:
SCHEDULE_REFRESH_TIMES=06:00,13:00,20:00
# Resumen semanal por correo (día @ hora: dom, lun, mar, mie, jue, vie, sab):
SCHEDULE_WEEKLY_EMAIL=dom@20:00
# Cierre mensual de gasto de IA por correo (día del mes 1-28 @ hora):
SCHEDULE_MONTHLY_EMAIL=1@08:00
# Resumen diario por correo (apagado por defecto; ejemplo: 07:00):
SCHEDULE_DAILY_EMAIL=off

# En Cloud Run el disco es memoria: tope (MB) de la copia local de archivos de Blackboard; lo más viejo se borra y se vuelve a bajar si hace falta.
FILES_CACHE_MAX_MB=300
